# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# App Settings
APP_ENV=development
MAX_TOKENS=1024
MAX_HISTORY_TURNS=10

# Mock Banking API
MOCK_API_BASE_URL=http://localhost:8000

# Session auth (Sprint 19) — signs customer/staff JWTs, see backend/src/auth.py
# REQUIRED: the app will not start with these missing or left as the example values.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_value
STAFF_USERNAME=staff
STAFF_PASSWORD=change_me
